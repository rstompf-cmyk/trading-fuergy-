# Skopíruj na `.env` a doplň reálne hodnoty.
# `.env` je v .gitignore (alebo by mal byť) — neverziuj ho.

# ─── Firemný historian (192.168.34.31:8088) ─────────────────────────────────
HISTORIAN_USER=admin
HISTORIAN_PASSWORD=admin#2023
HISTORIAN_HOST=http://192.168.34.31:8088

# ─── Server bind (pre Docker / produkčný server) ────────────────────────────
# APP_HOST=0.0.0.0
# APP_PORT=8000

# ─── PV koordináty pre auto-PVF fetch (scheduler) ───────────────────────────
# PV_LAT=48.1486
# PV_LON=17.1077
# PV_KWP=99.0
# PV_TILT=30.0
# PV_AZIMUTH=0.0

# ─── Vypínače background úloh (pre debug) ───────────────────────────────────
# NO_BACKFILL=1       # vypnúť backfill na štarte
# LIVESIM_BG=0        # vypnúť livesim background loop
# SCHEDULER=0         # vypnúť APScheduler
# SEPS_HEADED=1       # SEPS Playwright v headed móde
# HISTORIAN_HEADED=1  # Historian Playwright v headed móde
