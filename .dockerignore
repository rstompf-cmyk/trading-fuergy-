*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.Python
.pytest_cache/
.mypy_cache/

# Virtuálne prostredia
.venv/
venv/
env/

# Git + IDE
.git/
.gitignore
.gitattributes
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Lokálne dáta — patria do bind-mountovaného hostiteľského adresára, nie do image
out/
